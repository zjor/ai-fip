<mujoco model="free box">
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.9 0.8 0.8"/>
  </visual>

  <asset>
    <texture name="checker" type="2d" builtin="checker"
             rgb1="0.15 0.15 0.15" rgb2="0.85 0.85 0.85"
             width="256" height="256"/>
    <material name="checker-floor" texture="checker"
              texrepeat="2 2" texuniform="true" reflectance="0.1"/>
  </asset>

  <worldbody>
    <geom name="floor" type="plane" size="4 4 0.1" material="checker-floor"/>

    <body name="box-body" pos="0 0 0.8">
      <freejoint name="box-joint"/>
      <geom name="box" type="box" size="0.2 0.15 0.1" mass="1"
            solref="-1000 -5"
            rgba="0.2 0.55 0.9 1"/>
    </body>
  </worldbody>
</mujoco>
