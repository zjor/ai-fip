<mujoco model="pendulum">
  <compiler angle="degree"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.9 0.8 0.8"/>
  </visual>

  <asset>
    <texture name="checker" type="2d" builtin="checker"
             rgb1="0.15 0.15 0.15" rgb2="0.85 0.85 0.85"
             width="256" height="256"/>
    <material name="checker-floor" texture="checker"
              texrepeat="2 2" texuniform="true" reflectance="0.1"/>
  </asset>

  <worldbody>
    <geom name="floor" type="plane" size="2 2 0.1" material="checker-floor"/>
    <geom name="pivot-marker" type="sphere" pos="0 0 1.2" size="0.065"
          contype="0" conaffinity="0" rgba="0.2 0.2 0.2 1"/>

    <body name="pendulum" pos="0 0 1.2">
      <joint name="pivot" type="hinge" axis="0 1 0" damping="0.05"/>
      <geom name="rod" type="capsule" fromto="0 0 0 0.8 0 0"
            size="0.035" mass="0.3" rgba="0.85 0.35 0.15 1"/>
      <geom name="bob" type="sphere" pos="0.8 0 0" size="0.1"
            mass="0.7" rgba="0.2 0.65 0.9 1"/>
    </body>
  </worldbody>
</mujoco>
